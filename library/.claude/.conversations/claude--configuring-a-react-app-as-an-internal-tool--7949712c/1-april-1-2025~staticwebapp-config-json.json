
{
  "platform": {
    "apiRuntime": "node:18",
    "buildProperties": {
      "skipLint": true
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*.{png,jpg,gif}",
      "/css/*",
      "/robots.txt"
    ]
  },
  "routes": [
    {
      "route": "/internal/*",
      "rewrite": "/index.html",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/login",
      "rewrite": "/index.html"
    },
    {
      "route": "/*",
      "rewrite": "/index.html"
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/login",
      "statusCode": 302
    }
  },
  "globalHeaders": {
    "X-Robots-Tag": "noindex, nofollow"
  }
}
